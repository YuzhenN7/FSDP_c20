# Copy this file to ".env" and fill in the values. NEVER commit ".env" to Git.

# Neon connection string (Neon dashboard -> Connect -> copy the connection string).
# LEAVE THIS EMPTY until Neon is set up: the app then uses a temporary local database
# that is rebuilt from db/sample-data/ every time you start the server.
DATABASE_URL=
# Example once ready:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
